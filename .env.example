# probata — ortam değişkenleri (yalnız ADLAR; değer yazılmaz. Gerçek değerler yayında barındırmanın gizli ayarlarında, yerelde scripts/gelistir.ts üretir)
# ana alan adı: firma adresi <kısa ad>.<ana alan> (yerelde localhost)
PROBATA_ANA_ALAN=
# veritabanı (uygulama rolü; süper kullanıcı DEĞİL)
PROBATA_VT_SUNUCU=
PROBATA_VT_KAPI=
PROBATA_VT_AD=
PROBATA_VT_KULLANICI=
PROBATA_VT_PAROLA=
# ağ üzerinden bağlantıda zorunlu: dogrula (TLS + Supabase kök sertifikası); yerel 127.0.0.1'de boş
PROBATA_VT_SSL=
# havuz başına en çok bağlantı (yayında sunucusuz ortamda 2–3)
PROBATA_VT_HAVUZ=
# dosya deposu (yerelde klasör; yayında S3 uyumlu depo — K7). PROBATA_DEPO=vt: içerik veritabanında (deneme yayını, 347)
PROBATA_DEPO=
PROBATA_DEPO_KLASOR=
# firma sırlarının ana anahtarı: 32 bayt, base64 (kaybolursa kayıtlı sırlar çözülemez — yedeği ayrı ve güvenli yerde)
PROBATA_SIR_ANAHTARI=
# probata yönetim sayfasının adresi (tam ad, ör. yonetim.probata.com.tr); boşsa yönetim sayfası hiçbir adreste açılmaz (348)
PROBATA_YONETIM_ALAN=
