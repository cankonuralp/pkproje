# probata — ortam değişkenleri (yalnız ADLAR; değer yazılmaz. Gerçek değerler yayında barındırmanın gizli ayarlarında, yerelde scripts/gelistir.ts üretir)
# ana alan adı: firma adresi <kısa ad>.<ana alan> (yerelde localhost)
PROBATA_ANA_ALAN=
# veritabanı (uygulama rolü; süper kullanıcı DEĞİL)
PROBATA_VT_SUNUCU=
PROBATA_VT_KAPI=
PROBATA_VT_AD=
PROBATA_VT_KULLANICI=
PROBATA_VT_PAROLA=
# ağ üzerinden bağlantıda zorunlu: dogrula (TLS + Supabase kök sertifikası); yerel 127.0.0.1'de boş
PROBATA_VT_SSL=
# havuz başına en çok bağlantı (yayında sunucusuz ortamda 2–3)
PROBATA_VT_HAVUZ=
# dosya deposu: boş = yerel klasör; vt = içerik veritabanında (deneme yayını, 347); supabase = Supabase Storage (568; özel kova, 5 dk imzalı
# adres; eski veritabanı nesneleri gece taşınır). supabase için proje adresi + GİZLİ anahtar (Supabase › Project Settings › API keys › secret)
PROBATA_DEPO=
PROBATA_DEPO_KLASOR=
PROBATA_SUPABASE_URL=
PROBATA_SUPABASE_GIZLI=
PROBATA_SUPABASE_KOVA=
# firma sırlarının ana anahtarı: 32 bayt, base64 (kaybolursa kayıtlı sırlar çözülemez — yedeği ayrı ve güvenli yerde)
PROBATA_SIR_ANAHTARI=
# yapay zekâ ucu (boşsa Anthropic: https://api.anthropic.com); yalnız uçtan uca testte yerel taklit (351)
PROBATA_YZ_UC=
# probata yönetim sayfasının adresi (tam ad, ör. yonetim.probata.com.tr); boşsa yönetim sayfası hiçbir adreste açılmaz (348)
PROBATA_YONETIM_ALAN=
# gece işi ucunun (/api/is/gece) sırrı: en az 32 karakter; Vercel Cron isteğe kendisi ekler. Boşsa uç hiçbir isteği kabul etmez (378).
# FIRMA-VT FV7: proje sağlığı ucu (/api/saglik/projeler) bunu da kabul eder (zamanlayıcı — FV14). Duman testinin makinesine KONMAZ (gece işlerini açar)
CRON_SECRET=
# FIRMA-VT FV7 (2026-10-15, en az yetki): proje sağlığı ucunun AYRI sırrı — en az 32 görünür ASCII karakter, CRON_SECRET'ten farklı; yalnız bu ucu açar.
# Duman testi (tools/duman.mjs) aynı değeri kendi makinesinde PROBATA_DUMAN_SIR olarak verir. Boşsa uç yalnız CRON_SECRET'le açılır
PROBATA_SAGLIK_SIR=
# duyuru sayfalarının adresi (boşsa Bakanlığın asıl adresleri); yalnız uçtan uca testte yerel taklit (379)
PROBATA_DUYURU_UC=
# e-posta sağlayıcısının ucu (432; KOD-GECIS Y4). 536: anahtar ve gönderen alan adı FİRMANIN (Firma ayarları › E-posta; anahtar şifreli sır) —
# ortamda ortak anahtar yok. Uç boşsa Resend (https://api.resend.com/emails); yalnız uçtan uca testte yerel taklit
PROBATA_EPOSTA_UC=
# FIRMA-VT FV3: kendi veritabanlı firma başına havuz (1–5, boşsa 3), örnek başına firma havuzu sınırı (1–200, boşsa 32; meşgul havuz atılmaz —
# hepsi meşgulse geçici olarak en çok iki katı), alt alan adı çözümünün
# önbellekte kalma süresi sn (5–60, boşsa 15 — dondurulan firma bu kadar bayat kalabilir; giriş ve oturum yine kapalı)
PROBATA_FIRMA_HAVUZ=
PROBATA_FIRMA_HAVUZ_SAYI=
PROBATA_KAYIT_ONBELLEK_SN=
# FIRMA-VT FV4: göç dağıtıcının kipi (Vercel derleme adımı, scripts/goc-dagit.ts): boş = denetle (kodun beklediği göç merkezde ve her kendi
# veritabanlı firmada yoksa derleme durur; salt okunur). "uygula" (FV8): göçleri Supabase Yönetim API'siyle merkeze ve her firmaya uygular
# (önce hepsinde özet denetimi, sırayla, ilk hatada durur) — aşağıdaki yönetim anahtarı gerekir; yoksa derleme durur
PROBATA_GOC_DAGIT=
# FIRMA-VT FV8: Supabase Yönetim API'si — "probata otomasyon" kullanıcısının klasik PAT'i (yalnız Vercel ortamında; koda / veritabanına yazılmaz)
PROBATA_SUPABASE_YONETIM_ANAHTARI=
# yalnız test: Yönetim API'sinin yerel taklidi (http://127.0.0.1:<kapı>; yerel olmayan adres reddedilir)
PROBATA_SUPABASE_YONETIM_UC=
